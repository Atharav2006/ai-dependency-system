{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "dockerfilePath": "Dockerfile",
        "context": "."
    },
    "deploy": {
        "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
        "healthcheckPath": "/",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE"
    }
}
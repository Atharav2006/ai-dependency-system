{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "maxDuration": 60,
                "memory": 1024
            }
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/dashboard",
            "destination": "/frontend/index.html"
        },
        {
            "source": "/analytics",
            "destination": "/frontend/index.html"
        },
        {
            "source": "/login",
            "destination": "/frontend/index.html"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/frontend/$1",
            "continue": true
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/frontend/index.html"
        }
    ]
}